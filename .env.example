# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://signedshot:signedshot@localhost:5432/signedshot

# Storage (memory | redis)
STORAGE_TYPE=memory
REDIS_URL=redis://localhost:6379

# Session
SESSION_EXPIRY_SECONDS=300

# JWT (ES256)
# Generate a key with: openssl ecparam -name prime256v1 -genkey -noout
JWT_PRIVATE_KEY=
JWT_ISSUER=signedshot
JWT_AUDIENCE=signedshot
